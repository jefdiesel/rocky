{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rocky",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "alias": { "node-fetch": "./node-fetch-shim.cjs" },
  // CommonJS server code uses __dirname (dotenv path, client/dist check); not defined on Workers
  "define": { "__dirname": "\"/bundle/server/src\"" },
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }
}
